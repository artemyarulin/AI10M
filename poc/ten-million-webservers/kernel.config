# Linux 7.3.4, ARM64 QEMU guest. Applied with KCONFIG_ALLCONFIG + allnoconfig.
# Unrequested optional features stay off; Kconfig selects dependencies.
# Ubuntu provides the root filesystem, while this file configures its kernel.
#
# Compared with upstream ARM64 defconfig, AF_XDP needs XDP_SOCKETS=y.
# TUN, VFIO, and huge pages are already enabled in that stock config.
# The other sections configure the small QEMU guest and its UEFI boot.

# AF_XDP: sockets and loading/JIT-compiling the XDP redirect program.
CONFIG_XDP_SOCKETS=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y

# TUN and TAP share the /dev/net/tun driver.
CONFIG_TUN=y

# DPDK: VFIO PCI ownership, IOMMU support, and huge-page packet memory.
CONFIG_VFIO=y
CONFIG_VFIO_PCI=y
CONFIG_ARM_SMMU_V3=y
CONFIG_HUGETLBFS=y

# Linux networking for SSH, TUN/TAP routing, and the client VM.
CONFIG_NET=y
CONFIG_NET_CORE=y
CONFIG_NETDEVICES=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_UNIX=y
CONFIG_PACKET=y
CONFIG_NET_SCHED=y
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_RPS=y
CONFIG_RFS_ACCEL=y
CONFIG_NET_FLOW_LIMIT=y

# QEMU ARM64 hardware. NR_CPUS is a build limit; VMs still use 1 / 3 vCPUs.
# UEFI boots the kernel installed in /boot by init_vms.sh.
CONFIG_EFI=y
CONFIG_NR_CPUS=16
CONFIG_PCI=y
CONFIG_PCI_HOST_GENERIC=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_PCI_LEGACY=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_DMADEVICES=y
CONFIG_IOMMU_SUPPORT=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_PL031=y

# Serial boot console and SSH pseudo-terminals.
CONFIG_TTY=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_UNIX98_PTYS=y

# Disk, cloud-init seed, temporary files, and /dev, /proc, /sys.
CONFIG_BLOCK=y
CONFIG_BLK_DEV=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_VFAT_FS=y
CONFIG_ISO9660_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_UEVENT_HELPER=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_SYSCTL=y

# Ubuntu userspace: executables, libc syscalls, IPC, and file notifications.
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_FHANDLE=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_POSIX_TIMERS=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_SHMEM=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_DNOTIFY=y
CONFIG_INOTIFY_USER=y
CONFIG_FANOTIFY=y
CONFIG_FILE_LOCKING=y
CONFIG_MULTIUSER=y

# systemd isolation and the client network namespace.
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_SCHED=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_BPF=y

# Ubuntu service sandboxing and cryptographic interfaces.
CONFIG_SECCOMP=y
CONFIG_SECURITY=y
CONFIG_SECURITYFS=y
CONFIG_KEYS=y
CONFIG_CRYPTO=y
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_SHA256=y

# CPU/memory/socket measurements used in our experiments.
CONFIG_VIRT_CPU_ACCOUNTING_GEN=y
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_PROC_PAGE_MONITOR=y
CONFIG_PERF_EVENTS=y
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y
CONFIG_PRINTK_TIME=y
CONFIG_UNIX_DIAG=y
CONFIG_INET_DIAG=y
CONFIG_NETLINK_DIAG=y
CONFIG_CHECKPOINT_RESTORE=y

# Keep the existing small-kernel build settings and release name.
CONFIG_EXPERT=y
CONFIG_PRINTK=y
CONFIG_MODULES=y
CONFIG_SWAP=y
CONFIG_LOCALVERSION="-afxdp"
